TWELVE_DATA_API_KEY=your_key_here
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
SCAN_INTERVAL_MINUTES=15
PAIRS=XAU/USD,EUR/USD,GBP/USD,USD/JPY
TIMEFRAMES=1h,4h,1day
HTF_TIMEFRAME=1day
LTF_TIMEFRAME=1h
MIN_CONFLUENCE_SCORE=3
DB_URL=sqlite:///smc_bot.db

# ── Profitability roadmap (2026-08-24) ────────────────────────────────────
# SHORT-only evaluation mode: live ledger Jul 1–Aug 21 showed LONG at
# 3 wins / 26 trades / −920 pips vs SHORT +444 pips. Set to true to
# re-enable LONG entries (default in code is true; deploy with false).
ENABLE_LONG=false

# Recommended pair list for the evaluation period — NAS100 removed:
# negative in every backtest window and −352.7 pips / 11 trades live.
PAIRS=US30,XAU/USD,XAG/USD,EUR/USD,GBP/USD,USD/JPY

# Per-pair spread estimates (bot-pip units) deducted from PnL at every
# resolution. Defaults live in config.py; override selectively here.
# SPREADS_JSON={"XAU/USD": 5.0, "US30": 3.0}

# Kill-switch circuit breaker: alert when trailing mean R over the last
# KILL_SWITCH_LOOKBACK resolved signals ≤ KILL_SWITCH_R, needing at least
# KILL_SWITCH_MIN_N resolved signals on file.
KILL_SWITCH_LOOKBACK=30
KILL_SWITCH_MIN_N=20
KILL_SWITCH_R=-0.5
